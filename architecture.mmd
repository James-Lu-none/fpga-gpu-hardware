classDiagram
    direction TB

    class xdma_0 {
        <<Xilinx PCIe DMA>>
        +Clock: userclk1 (125MHz)
        +M_AXI_LITE: BAR0 Control
        +M_AXI: DMA Data Transfer (64-bit)
    }

    class gpu_processing_cluster {
        <<Graphics Processing Cluster>>
    }

    class picorv32_axi {
        <<RISC-V CPU Core>>
        +AXI4-Lite Master
    }

    class axi_crossbar_1 {
        <<AXI-Lite Crossbar 2x4>>
        +S00: RISC-V PicoRV32
        +S01: XDMA Host BAR0
        +M00: 128KB BRAM (0x00000)
        +M01: Control Regs (0x20000)
        +M02: GPC Core (0x10000000)
        +M03: UART Lite (0x20000000)
    }

    class rv_control_register {
        <<AXI-Lite Control Peripheral>>
        +CPU Soft Reset (0x04)
        +Host IRQ Doorbell (0x00)
    }

    class gpc_control_register {
        <<AXI-Lite GPC Peripheral>>
        +Scheduler Doorbell & Status (0x00~0x24)
        +I-RAM Broadcast Window (0x1000~0x1FFF)
    }

    class riscv_bram {
        <<Single-Port 128KB BRAM>>
        +Firmware & Stack (0x0000~0x0FFF)
        +Ring Buffer (0x18000~0x1FFFF)
    }

    class gpu_streaming_multiprocessor {
        <<SM: DMA & Control Engine>>
        +AXI-Lite Slave (Control & I-RAM)
        +AXI4-Full Master (256-bit)
    }

    class sm_warp_allocator {
        <<Global Warp Allocator>>
        +Dispatch Warp ID
        +Active Mask
    }

    class sm_processing_block {
        <<SMP: Sub-core Processing Block>>
        +True SIMT Architecture
    }

    class sm_warp_context {
        <<Context RAM & Micro-Scheduler>>
        +16 Resident Warps
        +Zero-Overhead Round-Robin
    }

    class sm_fetch_decode {
        <<Instruction Fetch & Decode>>
        +4KB I-RAM Cache
        +Custom ISA Decoder
    }

    class sm_vector_regfile {
        <<Vector Register File>>
        +2R1W Dual-Port BRAM
        +512 Registers (64-bit)
    }

    class sm_cuda_cores {
        <<CUDA Cores (SPs)>>
        +Stateless SIMD ALUs
        +Per-Lane Predication Masking
    }

    class axi_dwidth_converter_0 {
        <<AXI Data Width Converter>>
        +S: 64-bit AXI4
        +M: 256-bit AXI4
    }

    class axi_crossbar_0 {
        <<AXI Interconnect>>
        address range for ddr3 memory is defined here: 2^30 address bits
        +S00: DWidth Converter (256-bit)
        +S01: GPU Hardware Engine (256-bit)
        +M00: Clock Converter (256-bit)
    }

    class axi_clock_converter_0 {
        <<AXI Clock Converter (CDC)>>
        +S: 125MHz (userclk1)
        +M: 100MHz (ui_clk)
    }

    class mig_7series_0 {
        <<DDR3 Memory Controller>>
        +Clock: ui_clk (100MHz)
        +AXI4-Full Slave (256-bit)
    }

    class framebuffer_ram {
        <<Dual Port Video RAM>>
        +Port A: GPU (125MHz)
        +Port B: HDMI (Pixel Clock)
    }

    class hdmi_top {
        <<Display Controller>>
        +2-Stage Reset Synchronizer
        +HDMI Timing Gen & SiI9134 I2C
    }

    gpu_processing_cluster *-- gpu_streaming_multiprocessor

    gpu_streaming_multiprocessor *-- sm_warp_allocator
    gpu_streaming_multiprocessor *-- sm_processing_block

    sm_processing_block *-- sm_warp_context
    sm_processing_block *-- sm_fetch_decode
    sm_processing_block *-- sm_vector_regfile
    sm_processing_block *-- sm_cuda_cores

    %% Data & Control Flow Connections
    xdma_0 --> axi_crossbar_1 : 1a. AXI4-Lite
    picorv32_axi --> axi_crossbar_1 : 1b. AXI4-Lite

    axi_crossbar_1 --> riscv_bram : 1c. M00 BRAM Controller (0x0000_0000)
    axi_crossbar_1 --> rv_control_register : 1d. M01 Control Regs (0x0002_0000)
    axi_crossbar_1 --> gpc_control_register : 1e. M02 GPC Slave (0x1000_0000)
    axi_crossbar_1 --> axi_uartlite_0 : 1f. M03 UART Lite (0x2000_0000)

    xdma_0 --> axi_dwidth_converter_0 : 2a. AXI4 64-bit (xdma_dwconv_axi)
    axi_dwidth_converter_0 --> axi_crossbar_0 : 2b. AXI4 256-bit (dwconv_xbar_axi)

    gpc_control_register --> gpu_streaming_multiprocessor : 3. Internal Control & I-RAM Broadcast

    gpu_processing_cluster --> axi_crossbar_0 : 4. AXI4-Full (gpu_xbar_axi)

    axi_crossbar_0 --> axi_clock_converter_0 : 5a. AXI4 256-bit (xbar_cdc_axi)
    axi_clock_converter_0 --> mig_7series_0 : 5b. AXI4 256-bit (cdc_mig_axi)

    %% Internal SM Execution Flow
    sm_warp_allocator --> sm_warp_context : 6a. Allocate Grid Warps (Global Dispatch)
    sm_warp_context --> sm_fetch_decode : 6b. Issue Ready PC
    sm_fetch_decode --> sm_vector_regfile : 6c. Decode & Register IDs
    sm_vector_regfile --> sm_cuda_cores : 6d. Vector Operands
    sm_cuda_cores --> sm_vector_regfile : 6e. Write-Back Result
    sm_cuda_cores --> sm_warp_context : 6f. Update PC / Warp State

    %% Output
    sm_cuda_cores --> framebuffer_ram : 7. Render Pixel RGB (Future Integration)
    framebuffer_ram --> hdmi_top : 8. Scanout to HDMI Monitor
